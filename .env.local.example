# ── Máy chủ ─────────────────────────────────────────────────────────────
# Bí mật thật của Catch. Không bao giờ để lộ ra trình duyệt.
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Firebase ────────────────────────────────────────────────────────────
# Sáu biến dưới đây CHỈ định danh dự án, không phải bí mật — SDK phía trình
# duyệt bắt buộc nhìn thấy chúng, và Google thiết kế như vậy. Thứ quyết định ai
# đọc được gì là `firestore.rules`, không phải mấy dòng này. Nhớ deploy luật:
#     firebase deploy --only firestore:rules
#
# Lấy ở Firebase Console → Project settings → Your apps → Web app → SDK setup.
# Bật sẵn hai thứ trong Console: Authentication (Anonymous + Google) và Firestore.
#
# Bỏ trống cả cụm thì Catch vẫn chạy, chỉ là không đồng bộ — buổi học nằm trong
# trình duyệt máy đó.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Địa chỉ công khai ───────────────────────────────────────────────────
# Bị nướng vào thẻ og:image lúc build. Bỏ trống thì lùi về địa chỉ AI Studio.
NEXT_PUBLIC_SITE_URL=
