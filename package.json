{
  "name": "catch",
  "version": "0.1.0",
  "private": true,
  "description": "Catch — cham ky thuat boi tu video, tro giang cho lop pho cap boi",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "lint": "tsc --noEmit",
    "start": "node .next/standalone/server.js",
    "postbuild": "cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/ || true",
    "typecheck": "tsc --noEmit",
    "probe": "node private/probe/probe.mjs",
    "test": "node --test --experimental-strip-types --import ./test/register.mjs test/*.test.ts",
    "eval": "node private/probe/eval.mjs",
    "emu": "firebase-tools emulators:start --only auth,firestore --project catch-test",
    "rules": "firebase-tools deploy --only firestore:rules --project catch-64526"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
